{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Stores user profile information.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The unique identifier for the user." },
        "email": { "type": "string", "format": "email", "description": "The user's email address." },
        "displayName": { "type": "string", "description": "The user's display name." },
        "photoURL": { "type": "string", "format": "uri", "description": "The user's profile photo URL." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the user profile was created." }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "Note": {
      "title": "Note",
      "description": "A smart note with AI features.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "The unique identifier for the note." },
        "userId": { "type": "string", "description": "The ID of the user who owns the note." },
        "content": { "type": "string", "description": "The text content of the note." },
        "mood": { "type": "string", "enum": ["happy", "sad", "inspired", "thoughtful", "energetic", "calm"], "description": "The mood associated with the note." },
        "location": {
          "type": "object",
          "properties": {
            "latitude": { "type": "number" },
            "longitude": { "type": "number" },
            "address": { "type": "string" }
          }
        },
        "category": { "type": "string", "enum": ["idea", "inspiration", "memory", "status", "reminder"], "description": "The category of the note." },
        "type": { "type": "string", "enum": ["regular", "sticky"], "description": "The type of note (regular or self-destructing sticky)." },
        "expiresAt": { "type": "string", "format": "date-time", "description": "When the sticky note should self-destruct." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the note was created." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "When the note was last updated." },
        "isVoice": { "type": "boolean", "description": "Whether the note was created from voice." },
        "audioUrl": { "type": "string", "format": "uri", "description": "URL to the audio file if applicable." },
        "isPoetic": { "type": "boolean", "description": "Whether the note has been transformed into lyrics." },
        "lyrics": { "type": "string", "description": "The AI-generated lyrics based on the note." }
      },
      "required": ["id", "userId", "content", "category", "type", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "UserProfile",
      "description": "User profile documents."
    },
    "/notes/{noteId}": {
      "schema": "Note",
      "description": "Note documents."
    }
  }
}
